{
  "name": "ai-workflow-backend-node",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker/runWorker.ts",
    "dev:scheduler": "ts-node-dev --respawn --transpile-only src/worker/schedulerWorker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:schema": "ts-node-dev --transpile-only src/db/runSchema.ts",
    "db:seed": "ts-node-dev --transpile-only src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.11.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.10.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
