# Copy to .env if you need to override defaults.
# Defaults already target local Ollama.

OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:8b
OPENAI_EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
OLLAMA_THINK=false
NODE_BACKEND_URL=http://localhost:4000
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agent_memory
MAX_AGENT_ITERATIONS=15
